# ============================================
# PixelReview - iOS Fastlane Configuration
# ============================================
# Automated build and upload to TestFlight
# Configured identically to restaurantadmin
# ============================================

default_platform(:ios)

platform :ios do

  # ─────────────────────────────────────────
  # Setup API Key (runs before every lane)
  # ─────────────────────────────────────────
  before_all do
    UI.header("⭐ PixelReview - iOS Automation")

    @api_key = app_store_connect_api_key(
      key_id: "6RM87HWDZY",
      issuer_id: "dc9a069b-00fc-45f8-be31-84e435ea4d07",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_6RM87HWDZY.p8"),
      duration: 1200,
      in_house: false
    )

    UI.success("✅ API Key configured successfully")
  end

  # ─────────────────────────────────────────
  # Lane: Build & Upload to TestFlight
  # ─────────────────────────────────────────
  desc "Build iOS app and upload to TestFlight"
  lane :upload_app do
    UI.header("📦 Building & Uploading PixelReview to TestFlight")

    # Build the IPA using gym
    UI.message("🔨 Building IPA...")
    begin
      gym(
        workspace: File.expand_path("../ios/PixelReview.xcworkspace", File.dirname(__FILE__)),
        scheme: "PixelReview",
        export_method: "app-store",
        output_directory: File.expand_path("../build/ios/ipa", File.dirname(__FILE__)),
        output_name: "PixelReview.ipa",
        clean: true,
        export_options: {
          signingStyle: "automatic",
          teamID: "G67XQ5S4QU",
          uploadBitcode: false,
          uploadSymbols: true,
          compileBitcode: false
        }
      )
      UI.success("✅ IPA built successfully!")
    rescue => e
      UI.error("❌ Build failed!")
      UI.error("   Error: #{e.message}")
      raise e
    end

    # Upload to TestFlight
    UI.message("🚀 Uploading to TestFlight...")
    begin
      upload_to_testflight(
        api_key: @api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: false,
        distribute_external: false,
        changelog: "PixelReview Native React Native iOS Release",
        ipa: File.expand_path("../build/ios/ipa/PixelReview.ipa", File.dirname(__FILE__))
      )
      UI.success("✅ Successfully uploaded to TestFlight!")
    rescue => e
      UI.error("❌ TestFlight upload failed!")
      UI.error("   Error: #{e.message}")
      raise e
    end

    UI.header("🎉 SUCCESS!")
    UI.success("PixelReview uploaded to TestFlight!")
    UI.message("Check TestFlight in App Store Connect in 5-15 minutes.")
  end

  # ─────────────────────────────────────────
  # Lane: Build Only (no upload)
  # ─────────────────────────────────────────
  desc "Build iOS app without uploading"
  lane :build_only do
    UI.header("📦 Building iOS (No Upload)")

    gym(
      workspace: File.expand_path("../ios/PixelReview.xcworkspace", File.dirname(__FILE__)),
      scheme: "PixelReview",
      export_method: "app-store",
      output_directory: File.expand_path("../build/ios/ipa", File.dirname(__FILE__)),
      output_name: "PixelReview.ipa",
      clean: true,
      export_options: {
        signingStyle: "automatic",
        teamID: "G67XQ5S4QU",
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      }
    )

    UI.success("✅ IPA built at: build/ios/ipa/PixelReview.ipa")
  end

  # ─────────────────────────────────────────
  # Lane: Upload Only (skip build)
  # ─────────────────────────────────────────
  desc "Upload existing IPA"
  lane :upload_only do
    UI.header("🚀 Uploading to TestFlight...")

    upload_to_testflight(
      api_key: @api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: false,
      distribute_external: false,
      ipa: Dir[File.expand_path("../build/ios/ipa/*.ipa", File.dirname(__FILE__))].first
    )
  end

  # ─────────────────────────────────────────
  # Error handling
  # ─────────────────────────────────────────
  error do |lane, exception|
    UI.error("❌ Fastlane encountered an error in lane '#{lane}'")
    UI.error("   #{exception.message}")
  end

end
