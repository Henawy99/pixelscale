{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Flutter build handles dependencies'",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "devilssmashburger.at" }],
      "destination": "/order/devils-smash-burger",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.devilssmashburger.at" }],
      "destination": "/order/devils-smash-burger",
      "permanent": false
    }
  ]
}
